<?xml version="1.0" encoding="utf-8"?>
<!--
  Scopes code coverage to the project's testable surface.

  AlJourney.csproj is a Godot game project: the large majority of its classes derive from Godot.Node
  (or a similar engine type) and require a running Godot engine to instantiate — they cannot execute
  under a headless xUnit test host (see the "Testability boundary" section in
  Documentation/Documentation.md). Left unscoped, coverlet would instrument all of those classes too,
  report them at 0%, and make any aggregate line/branch coverage target structurally unreachable
  regardless of how well the actually-testable code is covered.

  This file excludes exactly the Godot-coupled namespaces/types, so the coverage percentage reflects
  the pure-logic code that unit tests are expected to exercise: Scripts.Core, Scripts.Data and
  Scripts.Battle.Rules.

  Pass this file to the XPlat Code Coverage collector via the "settings" option of "dotnet test".
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[AlJourney]AlJourney.Scripts.Managers.*,[AlJourney]AlJourney.Scripts.UI.*,[AlJourney]AlJourney.Scripts.Scenes.*,[AlJourney]AlJourney.Scripts.Characters.*,[AlJourney]AlJourney.Scripts.Utils.*,[AlJourney]AlJourney.Scripts.Battle.BattleManager,[AlJourney]AlJourney.Scripts.Battle.CombatEffectProcessor,[AlJourney]AlJourney.Scripts.Battle.EnemyAIController,[AlJourney]AlJourney.Scripts.Battle.EnemySpawner,[AlJourney]GodotPlugins.*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
