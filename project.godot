; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Altarion's Journey"
run/main_scene="res://Scenes/UI/MainMenu.tscn"
config/features=PackedStringArray("4.5", "C#", "Mobile")
config/icon="res://Resources/Sprites/UI/logo.png"
config/windows_native_icon="res://Resources/Sprites/UI/logo.ico"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://Resources/Sprites/UI/logo.png"
boot_splash/show_image=true

[autoload]

SaveSystem="*res://Scripts/Managers/SaveSystem.cs"
GameStateManager="*res://Scripts/Managers/GameStateManager.cs"
SceneManager="*res://Scripts/Managers/SceneManager.cs"
AudioManager="*res://Scripts/Managers/AudioManager.cs"
SettingsManager="*res://Scripts/Managers/SettingsManager.cs"
UIManager="*res://Scripts/Managers/UIManager.cs"
GridManager="*res://Scripts/Match3/GridManager.cs"
ComboSystem="*res://Scripts/Match3/ComboSystem.cs"
InventoryManager="*res://Scripts/Managers/InventoryManager.cs"
LootSystem="*res://Scripts/Managers/LootSystem.cs"
AbilitySystem="*res://Scripts/Managers/AbilitySystem.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="AlJourney"

[internationalization]

locale/translations=PackedStringArray("res://Data/Languages/translations.en.translation", "res://Data/Languages/translations.ru.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
